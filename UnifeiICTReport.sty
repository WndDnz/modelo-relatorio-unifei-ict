% \refcomp: referência cruzada completa, no formato "<Tipo> <número> - <título>".
%
% Uso normal (recomendado):  \refcomp{<ignorado>}{<rótulo>}
%   O nome do tipo é resolvido automaticamente pelo \autoref, conforme a cascata
%   definida no início deste arquivo (\chapter -> Seção, \section -> Subseção...).
%   O primeiro argumento é ignorado: ele existe apenas para manter compatível a
%   forma de chamada usada por \reffigcomp, \reftablecomp e \refeqcomp.
%
% Uso com asterisco:  \refcomp*{<Tipo>}{<rótulo>}
%   Imprime <Tipo> literalmente, para rótulos fora da hierarquia que o \autoref
%   reconhece (contadores próprios, ambientes personalizados etc.). Sem o
%   asterisco, esses rótulos sairiam apenas com o número, sem nome algum.
\NewDocumentCommand{\refcomp}{s m m}{%
    \IfBooleanTF{#1}{%
        % versão estrelada: nome do tipo literal, vindo do argumento
        \hyperref[#3]{\color{unifeiblue}{\textbf{#2~\ref*{#3} - \nameref*{#3}}}}%
    }{%
        % versão normal: nome do tipo resolvido pelo \autoref (ignora #2)
        \hyperref[#3]{\color{unifeiblue}{\textbf{\autoref*{#3} - \nameref*{#3}}}}%
    }%
}

% Nomes para referências tipo equação e suas traduções
\newcommand{\eqname}{Equation}
\addto\captionsbrazilian{\renewcommand{\eqname}{Equação}}
\addto\captionsspanish{\renewcommand{\eqname}{Ecuación}}
\addto\captionsfrench{\renewcommand{\eqname}{Équation}}
\addto\captionsgerman{\renewcommand{\eqname}{Gleichung}}

% Wrappers específicos para figuras, tabelas e equações usando o formato de \refcomp
% Uso: \reffig{<label>}, \reftable{<label>}, \refeq{<label>}
\providecommand{\reffig}[1]{\hyperref[#1]{\color{unifeiblue}\figurename~\ref{#1}}}
\providecommand{\reftable}[1]{\hyperref[#1]{\color{unifeiblue}\tablename~\ref{#1}}}
\providecommand{\refeq}[1]{\hyperref[#1]{\color{unifeiblue}\eqname~\ref{#1}}}
\providecommand{\reffigcomp}[1]{\refcomp{\figurename}{#1}}
\providecommand{\reftablecomp}[1]{\refcomp{\tablename}{#1}}
% \refeqcomp: accept a mandatory label and an optional custom name for the equation.
% Usage: \refeqcomp{<label>} or \refeqcomp{<label>}[<custom name>]
\NewDocumentCommand{\refeqcomp}{m o}{%
    \IfNoValueTF{#2}{%
        % no custom name: use the localized \eqname via \refcomp
        \refcomp{\eqname}{#1}%
    }{%
        % custom name provided: build same formatted hyperref but with the
        % provided name instead of \nameref*{#1}
        \hyperref[#1]{\color{unifeiblue}{\textbf{\eqname~\ref*{#1} - #2}}}%
    }%
}

% Redefine \quote to accept two parameters: bibliographic key and quoted text.
% Appearance:
% - Use the main document font (set via \setmainfont)
% - One size smaller than normal (\small)
% - Justified inside the quoted block (\justifying)
% - The quoted block is flush right and has a left indent of 4cm
% - The citation (\cite{<key>}) appears right-aligned inside the block
% Usage: \quote{<bibkey>}{<quoted text>}
\DeclareRobustCommand{\quote}[2]{%
    \par\bigskip%
    \noindent\hfill% push the box to the right
    \begin{minipage}{\dimexpr\linewidth-4cm\relax}% width reduced by 4cm
        {\normalsize\small% no indent, one size below normal
        \justifying\noindent #2\par% quoted text, justified
        \vspace{0.1\baselineskip}% small gap
        \hfill\raggedright{\footnotesize\cite{#1}}% citation right-aligned within the block
        }%
    \end{minipage}%
    \par\bigskip%
}

% Width declared by figuraabnt/tabelaabnt via their <width> argument (see
% below). Empty by default: \fonte then falls back to \LastGraphicWidth
% exactly as before this key existed, so undeclared floats render byte-identical.
\def\Unifei@DeclaredWidth{}

\providecommand{\fonte}[1]{%
    % Place the source text aligned to the left edge of the last included
    % graphic while matching caption styling: small size, sans-serif text
    % and label in bold sans-serif (same as \captionsetup{labelfont={bf,sf},textfont={sf}}).
    \par\vspace{2pt}% small gap after the figure
    {\small\sffamily% caption uses small + sans
        \ifx\Unifei@DeclaredWidth\@empty
            % If \LastGraphicWidth hasn't been set (no previous graphic), fall back
            % to full line width (left-aligned).
            \ifdim\LastGraphicWidth=0pt
                \makebox[\linewidth][l]{\textbf{\figuresourcename:}~#1.}\par
            \else
                % center an inner box of width \LastGraphicWidth and left-align
                % the source inside it so it sits at the left edge of the graphic
                \makebox[\linewidth][c]{% centered relative to the text block
                    \makebox[\LastGraphicWidth][l]{\textbf{\figuresourcename:}~#1.}%
                }\par
            \fi
        \else
            % Illustration declared its width explicitly (§5.8): \fonte follows
            % that width instead of the measured one, so caption, content and
            % source share the same left/right edges.
            \makebox[\linewidth][c]{%
                \makebox[\Unifei@DeclaredWidth][l]{\textbf{\figuresourcename:}~#1.}%
            }\par
        \fi
    }
}

%-------------------------------------------------
% AMBIENTES DE FIGURA E TABELA COM LEGENDA GARANTIDA (ABNT NBR 14724:2024)
%-------------------------------------------------
% A norma exige a legenda ACIMA da ilustração/tabela e a fonte ABAIXO. Com os
% ambientes figure/table crus isso depende de o autor escrever \caption antes do
% conteúdo — o hábito mais comum em LaTeX é o contrário, e sair errado não gera
% nenhum aviso na compilação. Estes dois ambientes recebem rótulo e legenda como
% argumentos e emitem a legenda antes do corpo, então não existe ordem errada
% possível de escrever.
%
% Uso: \begin{figuraabnt}[<posição>]{<rótulo>}{<legenda>}[<legenda curta>]<<largura>>
%          <conteúdo>
%          \fonte{<fonte>}
%      \end{figuraabnt}
% A posição padrão é [!htbp]; a legenda curta (para a Lista de Ilustrações) é
% opcional e vem por último. \fonte{} continua sendo chamado pelo autor, DENTRO
% do ambiente e depois do conteúdo — é o que o mantém junto do float na página.
%
% <<largura>>, entre "menor que"/"maior que" e opcional, declara a largura da
% ilustração (ex.: <0.9\textwidth>). Quando presente, a legenda e o \fonte{}
% passam a acompanhar exatamente essa largura, como exige o §5.8 ("Tipo, número
% de ordem, título, fonte, legenda e notas devem acompanhar as margens da
% ilustração"). Repita o mesmo valor passado a \includegraphics/à tabela. Sem
% esse argumento o comportamento é o de sempre: legenda na largura do bloco de
% texto e \fonte{} alinhado à largura medida do último gráfico.
%
% ATENÇÃO: \caption PRECISA vir antes de \label. É o \caption que incrementa o
% contador do float; com o \label antes, todo \ref para esse rótulo resolve para
% o contador do capítulo ("1") em vez do número da figura ("1.3"), sem erro nem
% aviso na compilação. Não inverta as duas linhas.
%
% Os ambientes figure/table crus continuam disponíveis, mas para eles o modelo
% não garante nada: a posição da legenda volta a depender da ordem do código.
% \Unifei@DeclareABNTEnv{<ambiente flutuante>}{<nome do ambiente ABNT>} gera um
% ambiente no molde figuraabnt/tabelaabnt em torno de QUALQUER ambiente
% flutuante existente (figure, table, ou um tipo declarado via
% \novotipoilustracao abaixo). figuraabnt e tabelaabnt são apenas as duas
% primeiras instâncias desta fábrica — seu nome e comportamento continuam
% exatamente os mesmos de antes.
\newcommand{\Unifei@DeclareABNTEnv}[2]{%
    \NewDocumentEnvironment{#2}{O{!htbp} m m o D<>{}}{%
        \def\Unifei@DeclaredWidth{##5}%
        \begin{#1}[##1]%
            \centering
            \ifx\Unifei@DeclaredWidth\@empty\else\captionsetup{width=\Unifei@DeclaredWidth}\fi
            \IfNoValueTF{##4}{\caption{##3}}{\caption[##4]{##3}}%
            \label{##2}%
            }{%
        \end{#1}%
    }%
}
\Unifei@DeclareABNTEnv{figure}{figuraabnt}
\Unifei@DeclareABNTEnv{table}{tabelaabnt}

%-------------------------------------------------
% TIPOS DE ILUSTRAÇÃO (NBR 14724:2024 §5.8)
%-------------------------------------------------
% §5.8: toda ilustração é precedida de sua palavra designativa (desenho,
% esquema, fluxograma, fotografia, gráfico, mapa, organograma, planta, quadro,
% retrato, figura, imagem, entre outros) — não existe uma palavra genérica
% "Figura" para todas elas. figuraabnt/tabelaabnt (acima) cobrem Figura e
% Tabela; \novotipoilustracao abre o mesmo tratamento para qualquer outro
% tipo, com contador, ambiente ABNT, referências cruzadas e lista próprios —
% sem reescrever essa máquina a cada tipo novo.
%
% Uso: \novotipoilustracao{<contador>}{<palavra designativa>}{<ambiente ABNT>}
%   <contador>: nome do ambiente/contador interno, só ASCII (ex.: quadro).
%   <palavra designativa>: como deve aparecer impressa (ex.: Quadro, Gráfico).
%   <ambiente ABNT>: nome do ambiente que o autor vai usar (ex.: quadroabnt).
% Gera: o ambiente <ambiente ABNT> (mesma assinatura de figuraabnt/tabelaabnt,
% incluindo a largura declarada opcional <<largura>>), \ref<contador>{} e
% \ref<contador>comp{} (no molde de \reffig/\reffigcomp), a lista
% \listof<contador>s (reaproveita o estilo de \listoffigures — mesma cor
% institucional, mesma fonte, mesmo cabeçalho centralizado — sem duplicar
% aquele bloco), e o número de ordem próprio do tipo, independente de
% Figura/Tabela/outros tipos (\counterwithout-equivalente via within=none).
%
% O nome é SEM "@" de propósito: este é o único comando desta seção que o
% autor chama do preâmbulo do próprio documento, onde "@" não é letra. Com um
% nome à la \Unifei@... o autor precisaria envolver a chamada em
% \makeatletter/\makeatother, e sem isso a compilação morre com "Undefined
% control sequence" — verificado por compilação. Os demais comandos desta
% seção são internos e mantêm o prefixo \Unifei@.
%
% Só funciona no preâmbulo: \DeclareFloatingEnvironment (do newfloat) é
% \@onlypreamble.
\newcommand{\novotipoilustracao}[3]{%
    \DeclareFloatingEnvironment[name={#2}, listname={Lista de #2s}, within=none, placement=!htbp]{#1}%
    % Herda a caixa alargada de \l@figure (fix-abnt-caption-label-format), não
    % o \numberline{2.3em} padrão do book.cls — senão "Quadro 1 –" sobrepõe o
    % título como a \l@figure original sobrepunha antes daquela correção.
    % Adiado para \AtBeginDocument: \l@figure só recebe essa caixa mais larga
    % bem mais abaixo neste arquivo (seção do Sumário), e um \let aqui, no
    % ponto em que o tipo é declarado, capturaria a definição estreita padrão
    % do book.cls em vez da personalizada.
    \AtBeginDocument{\expandafter\let\csname l@#1\endcsname\l@figure}%
    \DeclareCaptionListFormat{abnt#1}{##1\@nameuse{#1name}~##2 –~}%
    \captionsetup[#1]{listformat=abnt#1}%
    % Ganchos de acumulação de largura de subfigure (\S 216–265 acima) ficam
    % amarrados ao nome literal do ambiente "figure"; um tipo novo abre um
    % ambiente com outro nome e não os disparava sem este realinhamento.
    \AtBeginEnvironment{#1}{\setlength{\Unifei@CurrentFigureWidth}{0pt}}%
    \AtEndEnvironment{#1}{%
        \ifdim\Unifei@CurrentFigureWidth>0pt
            \global\setlength{\LastGraphicWidth}{\Unifei@CurrentFigureWidth}%
        \fi
    }%
    \Unifei@DeclareABNTEnv{#1}{#3}%
    \Unifei@GenXref{#1}%
}

% \Unifei@GenXref{<contador>} gera \ref<contador>/\ref<contador>comp no molde
% de \reffig/\reffigcomp (linhas ~613–617 acima), usando a palavra designativa
% do tipo (\<contador>name, definida por \DeclareFloatingEnvironment).
\newcommand{\Unifei@GenXref}[1]{%
    \expandafter\providecommand\csname ref#1\endcsname[1]{%
        \hyperref[##1]{\color{unifeiblue}\@nameuse{#1name}~\ref{##1}}%
    }%
    \expandafter\providecommand\csname ref#1comp\endcsname[1]{%
        \refcomp{\@nameuse{#1name}}{##1}%
    }%
}

% Tipos fornecidos pelo modelo: Quadro e Gráfico cobrem os casos observados em
% relatórios do ICT. Um tipo do §5.8 que o modelo não prevê (Fluxograma,
% Organograma, ...) usa o mesmo \novotipoilustracao — não requer editar o
% pacote.
\novotipoilustracao{quadro}{Quadro}{quadroabnt}
\novotipoilustracao{grafico}{Gráfico}{graficoabnt}

% Tabela (tabelaabnt, acima) fica FORA deste mecanismo de propósito: o §5.9
% rege tabelas à parte, vinculadas às normas de apresentação tabular do IBGE,
% com lista própria (§4.2.1.10) já coberta por \listoftables — não é um tipo
% de ilustração do §5.8.

%-------------------------------------------------
% CAPA E FOLHA DE ROSTO
%-------------------------------------------------
\renewcommand{\maketitle}{%
    % \pagenumbering{gobble}
    %----------------------------
    %   Capa
    %----------------------------
    \clearpage\thispagestyle{empty}
    {
        \setstretch{1.0}
        \begin{tikzpicture}[remember picture,overlay]
            \fill[unifeired] (current page.north west) rectangle ($(current page.south west) + (0.3cm, 0)$);
            \fill[unifeimedgrey] ($(current page.north west) + (0.3cm, 0)$) rectangle ($(current page.south west) + (0.9cm, 0)$);
            \fill[unifeiblue] ($(current page.north west) + (0.9cm, 0)$) rectangle ($(current page.south west) + (1.2cm, 0)$);
            \node[yslant=0.7, opacity=0.25] at ($(current page.center) + (5cm, -3cm)$) {\includegraphics[width=25cm]{Logos/simbolo_PANTONE}};
        \end{tikzpicture}
        \centering
        % Logo da instituição
        {\noindent\includegraphics[width=3cm]{Logos/simbolo_PANTONE}\par}
        \bigskip
        % Universidade
        {\color{unifeiblue}\unifeismallcaps{\LARGE\bfseries\@institution}\par}
        \vspace{1cm}
        {\large\@author\par}
        \vfill
        \begin{minipage}{\textwidth}
            \centering
            % Título e subtítulo em bloco contínuo, ambos em caixa alta; só o
            % título em negrito (ver \Unifei@FullTitleBloco).
            {\setstretch{1.0}\unifeifont\color{unifeiblue}\Huge
                \Unifei@FullTitleBloco{\MakeUppercase}\par}
        \end{minipage}
        \vfill\vfill
        {\unifeifont\large\parbox{\textwidth}{\centering\MakeUppercase{\@location}\par\the\year}\par}
    }
    \if@openright
        \cleardoublepage
    \else
        \clearpage
    \fi
    %------------------------------------------------
    % Folha de rosto
    %------------------------------------------------
    \begin{titlepage}
        \thispagestyle{empty}
        \centering % Centre everything on the page
        \setstretch{1.0}
        %------------------------------------------------
        %	Cabeçalhos
        %------------------------------------------------
        % Universidade
        {\color{unifeiblue}\unifeismallcaps{\Large\@institution}\\}\smallskip
        % Faculdade
        {\unifeifont\large{\@faculty}\\}\smallskip
        % Curso
        {\unifeifont\@course\\}\vspace{1cm}
        \vfill
        %------------------------------------------------
        %	Título e subtítulo
        %------------------------------------------------
        \begin{minipage}{\textwidth}
            \centering
            % Réguas
            {\color{unifeiblue}\hrule width \hsize height 2pt \kern 0.5mm \color{unifeired}\hrule width \hsize}
            \vspace{5mm}
            % Título
            % Título e subtítulo em bloco contínuo, ambos em caixa alta; só o
            % título em negrito (ver \Unifei@FullTitleBloco).
            {\setstretch{1.0}\LARGE\color{unifeiblue}\unifeifont
                \Unifei@FullTitleBloco{\MakeUppercase}\par}
            \vspace{5mm}
            % Réguas
            {\color{unifeired}\hrule width \hsize \kern 0.5mm \color{unifeiblue}\hrule width \hsize height 2pt}
            \vspace{1cm}

            %------------------------------------------------
            %	Autor(es) e orientador(es)
            %------------------------------------------------

            \parbox{\textwidth}{
                \begin{minipage}[t]{0.40\textwidth}
                    \setstretch{1.0}
                    \begin{flushleft}
                        \large
                        % Determine whether to use 'Autor' or 'Autores'
                        \begingroup
                        \edef\UnifeiICTReport@authdetok{\detokenize\expandafter{\@author}}%
                        \IfSubStr{\UnifeiICTReport@authdetok}{\string\\}{{\color{unifeiblue}\unifeismallcaps{\Large Autores}}}{{\color{unifeiblue}\unifeismallcaps{\Large Autor}}}\\
                        \vspace{0.25\baselineskip}
                        % print the provided author(s)
                        \large\@author
                        \endgroup
                    \end{flushleft}
                \end{minipage}
                ~
                % Supervisor box: only print if a supervisor name was provided.
                % We rely on the boolean \if@supervisorpresent set when \supervisor{...}
                % is invoked; this avoids false positives if \@supervisor gets populated
                % with invisible tokens by other processing.
                \if@supervisorpresent
                    \hfill%
                    \begin{minipage}[t]{0.40\textwidth}
                        \setstretch{1.0}
                        \begin{flushright}
                            {\color{unifeiblue}\unifeismallcaps{\Large\Unifei@papelrotulo}}\\
                            \vspace{0.25\baselineskip}
                            \large\@supervisor
                            \if@cosupervisorpresent
                                \par\vspace{0.5em}{\color{unifeiblue}\unifeismallcaps{\Large Coorientador}}\\
                                \vspace{0.25\baselineskip}
                                \large\@cosupervisor
                            \fi
                        \end{flushright}
                    \end{minipage}
                \fi
            }%
        \end{minipage}
        \vfill\vfill%
        \hfill%
        \begin{parbox}{0.5\textwidth}{
                \setstretch{1.0}
                \normalsize
                \Unifei@NaturezaFolhaRosto
            }
        \end{parbox}
        \vfill\vfill\vfill%
        %------------------------------------------------
        %	Logos no rodapé
        %------------------------------------------------
        \begin{minipage}{0.45\textwidth}
            \begin{flushleft} \includegraphics[width=0.8\textwidth]{Logos/assin_hor_PANTONE_pos}
            \end{flushleft}
        \end{minipage}
        \begin{minipage}{0.45\textwidth}
            \begin{flushright} \includegraphics[width=0.7\textwidth]{Logos/assin_hor_ICT}
            \end{flushright}
        \end{minipage}\\[.5 cm]
        {\large\parbox{\textwidth}{\centering\@location,~\@state,~\today}\par} % Data da compilação
    \end{titlepage}
    \setcounter{page}{2}%
    \if@openright
        \cleardoublepage
    \else
        \clearpage
    \fi
}

%-------------------------------------------------
% FOLHA DE APROVAÇÃO (NBR 14724:2024 §4.2.1.3)
%-------------------------------------------------
% Elemento obrigatório, sem título e sem indicativo numérico (§5.2.4) — por
% isso nada abaixo usa \chapter/\section ou \addcontentsline. Chame
% \folhaaprovacao logo depois de \maketitle (antes de \makeabstracts), como
% no driver deste modelo. Reaproveita \@title/\@subtitle/\@author/
% \@supervisor/\@subject já declarados para a capa — não precisam ser
% redeclarados.
%
% O tipo NÃO é mais parâmetro deste comando: vem da opção de pacote
% (\usepackage[<tipo>]{UnifeiICTReport}) e é consultado pelos booleanos
% derivados no topo do arquivo. Ver openspec/specs/document-type.
%
% DESVIOS DELIBERADOS DA NORMA — não "corrija" nenhum deles achando que é
% descuido; cada um tem base institucional registrada em
% openspec/changes/.../design.md, "Registro de desvios da norma":
%
%   D1  A folha NÃO tem linha de assinatura, em nenhum tipo. O §4.2.1.3 manda
%       o contrário ("as assinaturas dos componentes da banca examinadora
%       devem ser colocadas após a aprovação do trabalho"), mas a assinatura
%       passou a viver só na Ata de Defesa desde que as defesas se tornaram
%       inteiramente digitais. Verificado contra as teses recentes no
%       repositório institucional da Unifei: nenhuma traz assinatura na folha.
%       Aqui a folha REGISTRA composição da banca e data de aprovação.
%   D2  O tcc1 tem capa e resumo, que a NBR 15287 não exige (capa opcional no
%       §4.1.1, resumo ausente dos pré-textuais §4.2.1.1–6) — uniformidade
%       entre os modelos do ICT.
%   D3  O tcc1 pode ter folha de aprovação, que a NBR 15287 não prevê: no ICT
%       a defesa do projeto é facultativa, a critério do orientador.
%   D4  A natureza do tcc1 declara grau pretendido, contra o §4.2.1.1(e) da
%       15287, que pede só "tipo de projeto de pesquisa e nome da entidade".
%       Desde o PPC de 2023 o TCC do ICT é dividido em duas etapas e o TCC1 é
%       requisito parcial para o título: estrutura de projeto, finalidade de
%       monografia.
%
% #1/#2/#3 podem chegar como texto literal (de \bancamembro, digitado pelo
% autor) OU como uma referência de macro (\@supervisor) — \ifblank{#1} sozinho
% só detecta o segundo caso corretamente por acidente: uma referência de macro
% é sempre "1 token", nunca vazio, mesmo quando a macro referenciada está
% vazia. \edef normaliza os dois casos para texto já expandido antes de testar,
% então um \supervisor{} nunca declarado também produz um bloco corretamente
% em branco, não uma linha \textbf{} vazia.
%
% Nome antigo \Unifei@AssinaturaBloco abandonado de propósito: o bloco não
% reserva mais espaço para assinar, e manter o nome induziria ao erro de
% recolocar a régua (D1).
\newcommand{\Unifei@RegistroBloco}[3]{% #1=nome #2=titulação #3=instituição
    \par\vspace{2em}
    \begingroup
    \edef\Unifei@RBnome{#1}%
    \edef\Unifei@RBtitulacao{#2}%
    \edef\Unifei@RBinstituicao{#3}%
    \begin{center}
        \ifdefempty{\Unifei@RBnome}{\mbox{}\\}{\textbf{\Unifei@RBnome}\\}%
        \ifdefempty{\Unifei@RBtitulacao}{}{\Unifei@RBtitulacao\\}%
        \ifdefempty{\Unifei@RBinstituicao}{}{\Unifei@RBinstituicao}%
    \end{center}
    \endgroup
}

% Um bloco por professor, quando \supervisor traz vários separados por \\.
% Reaproveita a mesma convenção que a capa já usa para vários autores.
\newcommand{\Unifei@RegistroPorProfessor}[2]{% #1=lista \\ #2=papel
    \begingroup
    \def\Unifei@RPPpapel{#2}%
    \expandafter\Unifei@RPPloop#1\\\@nil
    \endgroup
}
\def\Unifei@RPPloop#1\\#2\@nil{%
    \Unifei@RegistroBloco{#1}{\Unifei@RPPpapel}{}%
    \def\Unifei@RPPresto{#2}%
    \ifx\Unifei@RPPresto\@empty\else\Unifei@RPPloop#2\@nil\fi
}

\newcommand{\Unifei@FolhaAprovacaoCabecalho}{%
    \begin{center}
        % Mesmo bloco contínuo da capa, mas em caixa normal — a caixa alta
        % fica restrita à capa e à folha de rosto.
        {\setstretch{1.0}\unifeifont\color{unifeiblue}\Large
            \Unifei@FullTitleBloco{\@firstofone}\par}
        \vspace{0.5em}
        {\large\@author\par}
    \end{center}
    \vspace{1.5em}
}

% Natureza: alinhada da metade do bloco de texto até a margem direita, espaço
% simples (§5.2) — mesmo padrão que \maketitle já usa na folha de rosto
% (\hfill + parbox{0.5\textwidth} com \setstretch{1.0}, ~linha 946 acima);
% reaproveitado aqui, não duplicado com valores diferentes.
\newcommand{\Unifei@FolhaAprovacaoNatureza}[1]{%
    \hfill%
    \begin{parbox}{0.5\textwidth}{%
        \setstretch{1.0}\normalsize
        #1%
        \ifdefempty{\@aprovacaodata}{}{\par\vspace{1em}Data de aprovação: \@aprovacaodata.}%
        \ifdefempty{\@notaaprovacao}{}{\par\vspace{0.5em}Nota: \@notaaprovacao.}%
    }%
    \end{parbox}%
    \par
}

% Complemento da natureza comum aos três tipos de monografia: área de
% concentração (exigida em dissertação/tese) e linha de pesquisa (opcional
% sempre). Nada aparece quando não declarados.
\newcommand{\Unifei@NaturezaComplemento}{%
    \ifdefempty{\@areaconcentracao}{}{\par\vspace{0.5em}Área de concentração: \@areaconcentracao.}%
    \ifdefempty{\@linhapesquisa}{}{\par\vspace{0.5em}Linha de pesquisa: \@linhapesquisa.}%
}

\newcommand{\Unifei@FolhaAprovacaoCorpo}{%
    \Unifei@FolhaAprovacaoCabecalho
    \if@unifei@relatorio
        \ifdefstring{\Unifei@doctype}{estagio}{%
            \Unifei@FolhaAprovacaoNatureza{%
                Relatório de estágio supervisionado apresentado como requisito
                parcial para aprovação na disciplina de \@subject.%
            }%
            \vfill
            % Três partes assinam o estágio: o próprio estagiário, o professor
            % orientador e o supervisor de campo.
            \Unifei@RegistroBloco{\@author}{\Unifei@rotuloestagiario}{}%
            \Unifei@RegistroPorProfessor{\@supervisor}{Orientador acadêmico}%
            \Unifei@RegistroBloco{\@empresasupervisor}{Supervisor de campo}{}%
            \vfill
        }{%
            \Unifei@FolhaAprovacaoNatureza{%
                Relatório apresentado ao professor da disciplina de \@subject,
                como requisito parcial para aprovação no semestre.%
            }%
            \vfill
            % Disciplina compartilhada tem mais de um professor responsável:
            % um bloco para cada.
            \Unifei@RegistroPorProfessor{\@supervisor}{\Unifei@papel\ da disciplina}%
            \vfill
        }%
    \fi
    \if@unifei@projeto
        % D4: declara grau, contra o §4.2.1.1(e) da 15287 — o TCC1 do ICT é
        % requisito parcial para o título, não projeto autônomo.
        \Unifei@FolhaAprovacaoNatureza{%
            Projeto de pesquisa apresentado como requisito parcial para
            obtenção do título de \Unifei@grau\ em \@subject, sendo o
            cumprimento das duas etapas do trabalho de conclusão de curso
            condição para a titulação.%
            \Unifei@NaturezaComplemento
        }%
        \vfill
        \Unifei@RegistroBanca
        \vfill
    \fi
    \if@unifei@monografia
        \Unifei@FolhaAprovacaoNatureza{%
            \ifdefstring{\Unifei@doctype}{tcc2}{Trabalho de Conclusão de Curso}{%
                \ifdefstring{\Unifei@doctype}{dissertacao}{Dissertação}{Tese}%
            }%
            \ apresentada como requisito parcial para obtenção do título de
            \Unifei@grau\ em \@subject.%
            \Unifei@NaturezaComplemento
        }%
        \vfill
        \Unifei@RegistroBanca
        \vfill
    \fi
}

% A banca é o orientador MAIS os membros externos declarados. O orientador
% entra a partir de \supervisor, sem exigir um \bancamembro que o repita.
\newcommand{\Unifei@RegistroBanca}{%
    \Unifei@RegistroPorProfessor{\@supervisor}{Orientador}%
    \Unifei@BancaLista
}

% Uso: \folhaaprovacao, sem argumento. O tipo vem da opção de pacote.
%
% No tcc1 a folha só sai se houve banca (D3) — sem banca declarada o texto foi
% avaliado individualmente e a folha não existe, sem deixar página em branco.
% Nos demais tipos ela é sempre emitida.
%
% O argumento opcional continua na assinatura só para RECUSAR a forma antiga
% com mensagem útil. Aceitar 'tcc' seria pior que falhar: ele se divide em
% tcc1 e tcc2, regidos por normas diferentes, e escolher um produziria um
% documento inteiro sob a norma errada, sem erro visível.
\NewDocumentCommand{\folhaaprovacao}{o}{%
    \IfNoValueTF{#1}{%
        \if@unifei@folhaopc
            \if@unifei@bancadeclarada
                \Unifei@FolhaAprovacaoEmitir
            \fi
        \else
            \Unifei@FolhaAprovacaoEmitir
        \fi
    }{%
        \PackageError{UnifeiICTReport}%
            {\string\folhaaprovacao\space não recebe mais o tipo como argumento}%
            {O tipo do documento agora é opção de pacote:
             \string\usepackage[<tipo>]{UnifeiICTReport}, com <tipo> em
             generico, estagio, tcc1, tcc2, dissertacao, tese.
             Chame \string\folhaaprovacao\space sem argumento.
             Atenção: o antigo 'tcc' virou DOIS tipos, tcc1 (projeto de
             pesquisa, NBR 15287) e tcc2 (monografia, NBR 14724) — escolha
             qual descreve o seu trabalho.}%
    }%
}

\newcommand{\Unifei@FolhaAprovacaoEmitir}{%
    \clearpage
    \thispagestyle{empty}%
    \Unifei@FolhaAprovacaoCorpo
    \clearpage
}

%----------------------------
%   IMPRIMIR OS RESUMOS
%----------------------------
\providecommand{\makeabstracts}{%
    \thispagestyle{empty}
    % Resumo title: center properly (usar mesma aparência dos títulos)
    {\centering\large\bfseries\unifeifont\color{unifeiblue}\MakeUppercase{Resumo}\par}
    \vspace{1.5cm}
    % abstract body (normal paragraph formatting)
    {\par\normalsize\setstretch{1.5}\@abstract\par}
    \vspace{0.5\baselineskip}
    {\par\noindent\textbf{Palavras-chave:} \@keywords\par}
    \vfill
    \if@openright
        \cleardoublepage
    \else
        \clearpage
    \fi
    %----------------------------
    %   ABSTRACT (SECOND LANGUAGE)
    %----------------------------
    % O resumo em língua estrangeira é obrigatório em dissertação e tese
    % (§4.2.1.8) e opcional nos demais tipos deste modelo. Quando é opcional e
    % não foi declarado, nada é emitido — nem página, nem cabeçalho — em vez de
    % uma página com título e corpo vazio. A cobrança do caso obrigatório está
    % no \AtBeginDocument junto com a da área de concentração, para o autor
    % descobrir a falta no começo da compilação e não no meio.
    \ifdefempty{\@abstractseclang}{}{%
        \thispagestyle{empty}
        % Abstract title: center properly (usar mesma aparência dos títulos)
        {\centering\large\bfseries\unifeifont\color{unifeiblue}\MakeUppercase{Abstract}\par}
        \vspace{1.5cm}
        % abstract body (normal paragraph formatting)
        {\par\normalsize\setstretch{1.5}\@abstractseclang\par}
        \vspace{0.5\baselineskip}
        {\par\noindent\textbf{Keywords:} \@keywordsseclang\par}
        \vfill
        \if@openright
            \cleardoublepage
        \else
            \clearpage
        \fi
    }%
}

% Capítulo: "Número~NomeCapítulo" no mesmo parágrafo
\titleformat{\chapter}[hang]{\unifeifont\color{unifeiblue}\Large\bfseries\MakeUppercase}{\thechapter}{0.5em}{}
\titlespacing*{\chapter}{0pt}{20pt}{10pt}
% Seções/subseções também usam a fonte institucional nos rótulos
\titleformat{\section}[hang]{\unifeifont\color{unifeiblue}\large\bfseries}{\thesection}{0.5em}{}
\titleformat{\subsection}[hang]{\unifeifont\color{unifeiblue}\large}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}[hang]{\unifeifont\color{unifeiblue}\normalsize}{\thesubsubsection}{1em}{}

% Redefine table of contents title to match chapter title styling
\renewcommand{\tableofcontents}{%
    \cleardoublepage
        	\thispagestyle{empty}% use plain pagestyle (page number placement)
    % Title styled like chapter titles: institutional font, color and uppercase
    {\centering\unifeifont\color{unifeiblue}\large\bfseries\MakeUppercase{\contentsname}\par}
    \vspace{1em}% small gap before the contents
    \@starttoc{toc}% actual TOC
    \if@openright\cleardoublepage\else\clearpage\fi
}

% Apply same styling to List of Figures
\renewcommand{\listoffigures}{%
    \cleardoublepage
    \thispagestyle{empty}
    {\centering\unifeifont\color{unifeiblue}\large\bfseries\MakeUppercase{\listfigurename}\par}
    \vspace{1em}
    \@starttoc{lof}
    \if@openright\cleardoublepage\else\clearpage\fi
}

% Apply same styling to List of Tables
\renewcommand{\listoftables}{%
    \cleardoublepage
    \thispagestyle{empty}
    {\centering\unifeifont\color{unifeiblue}\large\bfseries\MakeUppercase{\listtablename}\par}
    \vspace{1em}
    \@starttoc{lot}
    \if@openright\cleardoublepage\else\clearpage\fi
}

% Center and style glossary titles to match the document's pretext headings
% Redefine \glossarysection to accept an optional TOC title (first arg)
% and a mandatory printed title (second arg). Use the TOC title for
% running heads when provided, otherwise fall back to the printed title.
\renewcommand*{\glossarysection}[2][]{%
    \cleardoublepage
    	\thispagestyle{empty}%
    {\centering\unifeifont\color{unifeiblue}\large\bfseries\MakeUppercase{#2}\par}%
    \vspace{1em}%
    % choose running head: optional arg #1 if not empty, else printed title #2
    \ifdefempty{#1}{\markboth{#2}{#2}}{\markboth{#1}{#1}}%
}

\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

% ------------------------------------------------------------------
% Formatação das entradas do Sumário (ToC)
% Capítulos: \unifeifont, large, bold, uppercase
% Seções: normalfont, large, bold
% Subseções: normalsize, normalfont, sem bold
% Subsubseções: normalsize, normalfont, itálico
% Observação: evitamos criar novos comandos com nomes iniciados em "\t"
% (problema conhecido). Redefinimos as macros locais \l@... usadas pelo
% mecanismo de escrita do .toc.
\renewcommand{\l@chapter}[2]{%
    \ifnum \c@tocdepth>\m@ne
        \addpenalty{-\@highpenalty}%
        \vskip 1.0em \@plus\p@%
        % capítulos sem recuo lateral, número/reserva pequena
        \@dottedtocline{0}{0em}{1.5em}{% title
            {\unifeifont\color{unifeiblue}\normalsize\bfseries\MakeUppercase{#1}}%
        }{#2}% page
    \fi
}

\renewcommand{\l@section}[2]{%
    \ifnum \c@tocdepth>\z@
        \addpenalty{-\@highpenalty}%
        % recuo das seções um pouco menor
        \@dottedtocline{1}{1.0em}{2.0em}{% title
            {\unifeifont\color{unifeiblue}\normalsize\bfseries #1}%
        }{#2}% page
    \fi
}

\renewcommand{\l@subsection}[2]{%
    \ifnum \c@tocdepth>\tw@
        \addpenalty{-\@highpenalty}%
        % recuo das subseções reduzido
        \@dottedtocline{2}{2.2em}{2.6em}{% title
            {\unifeifont\color{unifeiblue}\normalsize #1}%
        }{#2}% page
    \fi
}

\renewcommand{\l@subsubsection}[2]{%
    % mostrar subsubsections quando tocdepth > 2 (i.e., tocdepth>=3)
    \ifnum \c@tocdepth>\tw@
        \addpenalty{-\@highpenalty}%
        % recuo das subsubseções reduzido
        \@dottedtocline{3}{4.0em}{3.2em}{% title
            {\unifeifont\color{unifeiblue}\normalsize\itshape #1}%
        }{#2}% page
    \fi
}

% book.cls reserves only 2.3em for \l@figure/\l@table (a bare number). Once
% the list format above injects the designative word and the travessão
% ("Figura 1 – "), that box overflows and collides with the title — verified
% by compiling. Widened to fit "Figura 100 – " (three digits, so the box
% does not need re-tuning the day a report reaches its hundredth figure).
\renewcommand{\l@figure}[2]{%
    \addpenalty{-\@highpenalty}%
    \@dottedtocline{1}{0em}{6.5em}{{\unifeifont\color{unifeiblue}\normalsize #1}}{#2}%
}
\renewcommand{\l@table}[2]{%
    \addpenalty{-\@highpenalty}%
    \@dottedtocline{1}{0em}{6.5em}{{\unifeifont\color{unifeiblue}\normalsize #1}}{#2}%
}

% 1. Redefinir o \frontmatter
\renewcommand\frontmatter{
    \cleardoublepage
    \@mainmatterfalse % Mantém os capítulos como \chapter*
    \pagenumbering{arabic} % <-- MUDANÇA: Inicia com números arábicos
    \pagestyle{empty}      % <-- ADIÇÃO: Esconde os números de página
}

% 2. Redefinir o \mainmatter
\renewcommand\mainmatter{
    \cleardoublepage
    \@mainmattertrue  % Habilita capítulos numerados (\chapter)
    % A linha \pagenumbering{arabic} foi REMOVIDA daqui
    % para impedir que o contador seja reiniciado.
    \pagestyle{plain} % <-- ADIÇÃO: Torna os números visíveis
}

% \backmatter NÃO é redefinido aqui, de propósito: o \backmatter herdado do
% book.cls só faz \cleardoublepage/\clearpage + \@mainmatterfalse. Isso deixa
% \chapter sem número (irrelevante aqui — apêndices/anexos não usam \chapter)
% e NÃO mexe em \pagestyle, que continua "plain" (números de página visíveis,
% contínuos) — exatamente o que o §5.3 exige. Confirmado lendo o próprio
% book.cls, não só supondo.

%-------------------------------------------------
% APÊNDICES E ANEXOS (NBR 14724:2024 §4.2.3.3/§4.2.3.4)
%-------------------------------------------------
% Por que não reaproveitar \chapter/\appendix: (a) \titleformat{\chapter} acima
% imprime o contador cru — \appendix produziria só "A", sem a palavra; (b) o
% nome do \autoref precisaria mudar por região. Testado por compilação (não
% suposto): um \renewcommand{\chapterautorefname}{...} lido pelo \autoref no
% momento da REFERÊNCIA, não do \label — uma referência escrita depois da troca
% mas apontando para um rótulo do corpo principal escrito antes dela sai errada
% ("Apêndice 1" em vez de "Seção 1"). Ver design.md, "Resolved Questions", para
% o resultado completo do teste.
%
% A solução que evita o problema por construção: cada grupo (apêndice/anexo)
% tem seu PRÓPRIO contador, nunca compartilhado com \c@chapter, e sua PRÓPRIA
% palavra de \autoref — fixa, nunca trocada. \chapterautorefname continua
% "Seção" o documento inteiro, sem exceção.
\newcounter{apendicesec}
\newcounter{anexosec}
\newcounter{Unifei@tmpAlph}

% Conversão contador -> letra, dobrando após Z (AA, BB, ..., ZZ), como exige o
% §4.2.3.3. PRECISA ser totalmente expansível: \refstepcounter grava
% \thecontador dentro de um \edef (\@currentlabel), e um \setcounter (que faz
% uma atribuição, não expansível) dentro dessa cadeia corrompe o rótulo em vez
% de dar erro claro — verificado por compilação. \@Alph{<número>} (usado por
% \Alph internamente) é expansível; \setcounter não é. Por isso \@Alph aqui, e
% não \Alph{Unifei@tmpAlph} com um contador auxiliar.
% Acima de 52 devolve o número cru. Não é um "resultado válido" — é só uma
% degradação que mantém a expansão legal; quem reclama é
% \Unifei@ChecarTetoGrupo, abaixo. \PackageError AQUI dentro seria um erro:
% este comando é expandido pelo \protected@edef do \refstepcounter, e o
% \GenericError inteiro acabava gravado no .aux como o VALOR do rótulo
% (\newlabel{...}{{\GenericError ...}}), corrompendo o rótulo e re-disparando
% o erro a cada compilação seguinte — reproduzido e confirmado por compilação.
\newcommand{\Unifei@GroupLetter}[1]{%
    \ifnum\value{#1}>52
        \number\value{#1}%
    \else
        \ifnum\value{#1}>26
            \@Alph{\numexpr\value{#1}-26\relax}\@Alph{\numexpr\value{#1}-26\relax}%
        \else
            \@Alph{\value{#1}}%
        \fi
    \fi
}

% Levantado logo DEPOIS do \refstepcounter, em contexto normal (não
% expansível) — é aqui que o teto do §4.2.3.3 é aplicado de verdade.
\newcommand{\Unifei@ChecarTetoGrupo}[1]{%
    \ifnum\value{#1}>52
        \PackageError{UnifeiICTReport}%
            {Sequência de apêndices/anexos excedeu 52 entradas}%
            {A NBR 14724:2024 \string\S 4.2.3.3\space prevê letras dobradas (AA a ZZ)
             além de Z, mas não define convenção alguma depois disso.
             Reorganize o documento.}%
    \fi
}
\renewcommand{\theapendicesec}{\Unifei@GroupLetter{apendicesec}}
\renewcommand{\theanexosec}{\Unifei@GroupLetter{anexosec}}

% Nome de \autoref fixo por grupo — nunca trocado, então \refcomp{}{rótulo} e
% \autoref{rótulo} já resolvem corretamente para qualquer rótulo de apêndice
% ou anexo, sem precisar de um \refapendice/\refanexo dedicado.
\newcommand{\apendicesecautorefname}{Apêndice}
\newcommand{\anexosecautorefname}{Anexo}

% Abre o GRUPO: registra o texto coletivo do sumário — "APÊNDICES"/"ANEXOS",
% uma linha só, não uma por letra, seguindo o modelo publicado pela UFV citado
% no design.md — mas NÃO o escreve ainda. \addcontentsline captura \thepage no
% momento em que é chamado; chamá-lo aqui, ainda na página onde \apendices foi
% escrito no código (antes do \cleardoublepage do primeiro \apendice), gravaria
% o número de página ERRADO — reproduzido por compilação: tanto "APÊNDICES"
% quanto "ANEXOS" apontavam para a mesma página, a do último elemento antes
% deles. Em vez disso, \apendice/\anexo (abaixo) consomem este texto pendente
% logo depois do PRÓPRIO \cleardoublepage, quando \thepage já é a página certa.
\def\Unifei@ApendicesPendente{}%
\def\Unifei@AnexosPendente{}%
\newcommand{\apendices}{\def\Unifei@ApendicesPendente{APÊNDICES}}
\newcommand{\anexos}{\def\Unifei@AnexosPendente{ANEXOS}}

% Comando interno: abre UM apêndice/anexo, já na página certa (\cleardoublepage
% já executado por \apendice/\anexo). #1=contador #2=palavra #3=rótulo #4=título
% Título centralizado, mesma ênfase do \chapter (\unifeifont, unifeiblue,
% \Large\bfseries, uppercase — igual à linha ~1013 acima), sem indicativo
% numérico (§5.2.3) — a letra faz parte do texto do título, não é um número de
% seção.
%
% ATENÇÃO: \label PRECISA vir depois de \hyper@makecurrent e \NR@gettitle, que
% por sua vez PRECISAM vir depois do \chapter* de exibição. Motivo, verificado
% por compilação (ver design.md): \chapter*, mesmo estrelado, dispara a própria
% âncora do hyperref para o marcador de PDF, sobrescrevendo o contexto que
% \refstepcounter tinha acabado de montar — sem o \hyper@makecurrent, \label
% capturaria "chapter" em vez do contador dedicado, e toda referência a ele
% sairia "Seção X" em vez de "Apêndice X"/"Anexo X". Pelo mesmo motivo, o
% pacote nameref normalmente ensina \chapter* a registrar \@currentlabelname
% (usado por \nameref, e portanto por \refcomp) via um patch em \@schapter —
% mas o titlesec, carregado depois, reescreve a maquinaria de capítulo e some
% com esse gancho: sem o \NR@gettitle abaixo, \refcomp a um apêndice/anexo
% imprimiria o nome do ÚLTIMO capítulo numerado real, não o título do próprio
% apêndice/anexo — reproduzido e confirmado por compilação. Não inverta a
% ordem desses três comandos.
\newcommand{\Unifei@AbrirElementoPosTextualCorpo}[4]{%
    \thispagestyle{plain}%
    \refstepcounter{#1}%
    \Unifei@ChecarTetoGrupo{#1}%
    {\centering\unifeifont\color{unifeiblue}\Large\bfseries
        \MakeUppercase{#2\ \csname the#1\endcsname\ —\ #4}\par}%
    \vspace{1em}%
    \hyper@makecurrent{#1}%
    \NR@gettitle{#4}%
    \label{#3}%
}

% Uso: \apendice{<rótulo>}{<título>} / \anexo{<rótulo>}{<título>}, um por
% apêndice/anexo, depois de \apendices/\anexos ter aberto o grupo.
\newcommand{\apendice}[2]{%
    \cleardoublepage
    \ifx\Unifei@ApendicesPendente\@empty\else
        \phantomsection
        \addcontentsline{toc}{chapter}{\Unifei@ApendicesPendente}%
        \gdef\Unifei@ApendicesPendente{}%
    \fi
    \Unifei@AbrirElementoPosTextualCorpo{apendicesec}{APÊNDICE}{#1}{#2}%
}
\newcommand{\anexo}[2]{%
    \cleardoublepage
    \ifx\Unifei@AnexosPendente\@empty\else
        \phantomsection
        \addcontentsline{toc}{chapter}{\Unifei@AnexosPendente}%
        \gdef\Unifei@AnexosPendente{}%
    \fi
    \Unifei@AbrirElementoPosTextualCorpo{anexosec}{ANEXO}{#1}{#2}%
}

\endinput
