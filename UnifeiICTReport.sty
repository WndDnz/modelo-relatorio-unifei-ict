% --- Defaults ---
\newcommand{\@subtitle}{}
\providecommand{\subtitle}[1]{\renewcommand{\@subtitle}{#1}}

% --- Trio \title / \subtitle / \fulltitle ---
%
% \fulltitle é a composição: título + dois-pontos + subtítulo. Os dois-pontos
% são exigidos pela NBR 14724:2024 §4.1.1, alínea d): "subtítulo: se houver,
% deve ser precedido de dois-pontos, evidenciando a sua subordinação ao
% título".
%
% Os dois-pontos são do MODELO, não do autor: \subtitle{} recebe só o texto do
% subtítulo, e a pontuação aparece sozinha sempre que houver subtítulo. Assim
% não existe documento com título e subtítulo sem a marca de subordinação, nem
% dois-pontos duplicado por quem já digitou um. Sem subtítulo, \fulltitle é
% apenas o título, sem dois-pontos órfão.
%
% A norma enuncia a regra explicitamente só em 4.1.1 (capa); em 4.2.1.1.1(c)
% (folha de rosto) e 4.2.1.3 (folha de aprovação) ela apenas lista "subtítulo,
% se houver", sem repetir a pontuação. Este modelo aplica nas três, porque os
% dois-pontos são a marca da própria subordinação — não um enfeite da capa —,
% e é o que fazem tanto os modelos publicados pela UFV quanto a NBR 6023, que
% separa título e subtítulo por dois-pontos nas referências. Use \@title cru
% se algum dia for preciso o título sem essa marca.
%
% Usa \ifx...\else...\fi em vez de \ifdefempty (usado no resto do arquivo) de
% propósito: assim \fulltitle é totalmente expansível e pode ir para dentro de
% um \edef, de metadados de PDF ou de uma referência cruzada sem se quebrar.
\newcommand{\fulltitle}{%
    \@title\ifx\@subtitle\@empty\else: \@subtitle\fi
}

% Versão diagramada do mesmo conteúdo, para as folhas que exibem o título em
% destaque. Título e subtítulo formam um BLOCO CONTÍNUO — sem quebra de
% parágrafo entre eles, fluindo como um texto só — e o que distingue as duas
% partes é o peso: título em negrito, subtítulo sem negrito. Por isso não há
% mudança de corpo entre um e outro; quem chama define o tamanho do bloco
% inteiro.
%
% #1 é a transformação de caixa aplicada às duas partes: \MakeUppercase na
% capa e na folha de rosto, \@firstofone (identidade, caixa normal) no
% restante do documento.
\newcommand{\Unifei@FullTitleBloco}[1]{%
    {\bfseries#1{\@title}\ifx\@subtitle\@empty\else:\fi}%
    \ifx\@subtitle\@empty\else\ #1{\@subtitle}\fi
}

% Rótulo do papel do professor na capa e na folha de rosto. Deriva do tipo
% (\Unifei@papel/\Unifei@papelplural, resolvidos no topo do arquivo) e vai ao
% plural quando \supervisor traz mais de um nome — usando exatamente a mesma
% detecção que a capa já faz para alternar entre "Autor" e "Autores": procurar
% \\ no valor detokenizado. Não é uma segunda convenção, é a mesma.
%
% Resolvido de uma vez em \AtBeginDocument, quando \supervisor já foi
% declarado, deixando \Unifei@papelrotulo como macro simples. Isso NÃO é
% preciosismo: o rótulo é usado dentro de \unifeismallcaps, que aplica
% \MakeUppercase ao argumento, e fazer \begingroup/\IfSubStr/\endgroup lá
% dentro trava a compilação em laço infinito — verificado.
\def\Unifei@papelrotulo{\Unifei@papel}
\def\Unifei@rotuloestagiario{Aluno estagiário}
\AtBeginDocument{%
    \edef\Unifei@PRdetok{\detokenize\expandafter{\@supervisor}}%
    \IfSubStr{\Unifei@PRdetok}{\string\\}%
        {\let\Unifei@papelrotulo\Unifei@papelplural}%
        {\let\Unifei@papelrotulo\Unifei@papel}%
    % Mesma pluralização para o bloco do estagiário na folha de estágio: o
    % rótulo é campo de \Unifei@RegistroBloco, que faz \edef no argumento, e
    % \IfSubStr não sobrevive a \edef — por isso resolvido aqui também, e não
    % no ponto de uso.
    \edef\Unifei@PAdetok{\detokenize\expandafter{\@author}}%
    \IfSubStr{\Unifei@PAdetok}{\string\\}%
        {\def\Unifei@rotuloestagiario{Alunos estagiários}}%
        {\def\Unifei@rotuloestagiario{Aluno estagiário}}%
}

% Natureza da folha de rosto, por tipo. Mesmo texto que a folha de aprovação
% usa, mantido em um só lugar para os dois não divergirem com o tempo.
\newcommand{\Unifei@NaturezaFolhaRosto}{%
    \if@unifei@relatorio
        \ifdefstring{\Unifei@doctype}{estagio}%
            {Relatório de estágio supervisionado apresentado como requisito
             parcial para aprovação na disciplina de \@subject.}%
            {Relatório apresentado ao professor da disciplina de \@subject,
             como requisito parcial para aprovação no semestre.}%
    \fi
    \if@unifei@projeto
        Projeto de pesquisa apresentado como requisito parcial para obtenção
        do título de \Unifei@grau\ em \@subject, sendo o cumprimento das duas
        etapas do trabalho de conclusão de curso condição para a titulação.%
        \Unifei@NaturezaComplemento
    \fi
    \if@unifei@monografia
        \ifdefstring{\Unifei@doctype}{tcc2}{Trabalho de Conclusão de Curso}{%
            \ifdefstring{\Unifei@doctype}{dissertacao}{Dissertação}{Tese}%
        }%
        \ apresentada como requisito parcial para obtenção do título de
        \Unifei@grau\ em \@subject.%
        \Unifei@NaturezaComplemento
    \fi
}
