% Banca examinadora: cada membro precisa de nome, titulação e instituição —
% não cabe no padrão \supervisor{<nome>} de um único valor. Em vez de um
% pacote de chave-valor, um comando repetível que ACUMULA (via
% \g@addto@macro, mecanismo padrão do núcleo do LaTeX2e) uma lista de chamadas
% a \Unifei@RegistroBloco, disparada de uma vez na hora de renderizar a folha.
% Chame uma vez por membro esperado — inclusive com campos em branco, se os
% nomes ainda não forem conhecidos: o resultado é um bloco corretamente
% formatado, mas vazio, não um erro (a folha é preparada antes da defesa).
%
% O ORIENTADOR NÃO ENTRA AQUI: ele é membro da banca (tipicamente presidente),
% mas já foi declarado em \supervisor para a capa, e a folha o inclui a partir
% dali. Declará-lo de novo produziria o nome duplicado.
\newcommand{\Unifei@BancaLista}{}
\newif\if@unifei@bancadeclarada\@unifei@bancadeclaradafalse
\providecommand{\bancamembro}[3]{% #1=nome #2=titulação #3=instituição
    \g@addto@macro\Unifei@BancaLista{\Unifei@RegistroBloco{#1}{#2}{#3}}%
    \@unifei@bancadeclaradatrue
}

% Cobrança do que o tipo exige. Roda em \AtBeginDocument, depois de o preâmbulo
% inteiro ter sido lido — cobrar antes acusaria falta de um metadado que o autor
% ainda vai declarar duas linhas abaixo. Falhar é melhor que emitir a folha ou o
% resumo silenciosamente incompletos, que é o modo como esse tipo de defeito
% costuma passar despercebido até a versão impressa.
\AtBeginDocument{%
    \if@unifei@areaobrig
        \ifdefempty{\@areaconcentracao}{%
            \PackageError{UnifeiICTReport}%
                {Falta a área de concentração}%
                {O tipo '\Unifei@doctype' exige \string\areaconcentracao{...}.
                 A NBR 14724:2024 \string\S 4.2.1.1.1(e) inclui a área de
                 concentração na natureza do trabalho.}%
        }{}%
    \fi
    \if@unifei@absobrig
        \ifdefempty{\@abstractseclang}{%
            \PackageError{UnifeiICTReport}%
                {Falta o resumo em língua estrangeira}%
                {O tipo '\Unifei@doctype' exige \string\abstractseclang{...}.
                 A NBR 14724:2024 \string\S 4.2.1.8 torna o resumo em língua
                 estrangeira elemento obrigatório.}%
        }{}%
    \fi
}

